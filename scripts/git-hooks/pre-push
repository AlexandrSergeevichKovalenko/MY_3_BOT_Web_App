#!/bin/sh
# Гоняет набор тестов перед каждым git push. Красное — пуш не уходит.
#
# Зачем: тесты не запускались автоматически нигде, поэтому за месяцы накопилось
# 40 красных, и настоящая поломка (счётчики повторений FSRS) тонула среди них.
#
# ПОЧЕМУ ХУК ЗАПОМИНАЕТ ПРОГОН (02.08.2026). Пуш регулярно падал с «Failed to connect
# to github.com port 443 after 75000 ms», и это списывали на капризную сеть. Трассировка
# (GIT_CURL_VERBOSE=1) показала другое: git соединяется за 42 мс, забирает список веток,
# потом ЖДЁТ 77 секунд, пока здесь идут тесты; к этому моменту curl пишет «Connection 0
# seems to be dead», git переподключается — и вот это переподключение висит 75 секунд.
# То есть пуш убивал наш собственный хук, а не сеть: у fetch и ls-remote такой паузы нет,
# и они работают мгновенно.
#
# Лечение — не делать паузу в середине пуша:
#   • основной путь — ./scripts/push.sh: прогоняет тесты ДО того, как git полезет в сеть,
#     и только потом пушит; соединение не успевает протухнуть;
#   • этот хук помнит, для какого состояния кода тесты уже были зелёными, и тогда
#     пропускает прогон мгновенно. Поэтому если обычный `git push` всё-таки оборвался по
#     таймауту — просто повторите его: второй раз уйдёт без паузы и без обрыва.
#
# Срочно нужно запушить, несмотря на красное:  git push --no-verify
#
# Переустановить хук после клонирования репозитория:
#   ./scripts/git-hooks/install.sh

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$REPO_ROOT" || exit 0

# Тесты не должны трогать боевую базу: без этого импорт приложения делает DDL
# в проде (в окружении разработчика лежат боевые креденшелы).
export SKIP_STARTUP_SCHEMA_BOOTSTRAP=1

# Отпечаток ИМЕННО ТОГО КОДА, который сейчас на диске: коммит плюс хеш незакоммиченных
# правок в отслеживаемых файлах. Один только коммит брать нельзя — в общем рабочем
# каталоге поверх него почти всегда лежит чужой или свой WIP, и «зелено на этом коммите»
# ничего бы не значило.
#
# Неотслеживаемые файлы в отпечаток намеренно НЕ входят: они не уезжают в пуш, а в этом
# каталоге их всегда несколько (черновики, наброски), и память сбрасывалась бы от каждого
# временного файла. Цена: если новый файл ещё не добавлен в git, изменения в нём память
# не заметит — но и запушить его нельзя, пока он не добавлен, так что до сервера такой
# код всё равно не доедет непроверенным.
code_fingerprint() {
    head_sha=$(git rev-parse HEAD 2>/dev/null || echo "no-head")
    dirty_sha=$(git diff HEAD 2>/dev/null | git hash-object --stdin 2>/dev/null || echo "no-diff")
    echo "$head_sha:$dirty_sha"
}

VERIFIED_FILE=$(git rev-parse --git-path pre-push-verified 2>/dev/null)
FINGERPRINT=$(code_fingerprint)

if [ -n "$VERIFIED_FILE" ] && [ -f "$VERIFIED_FILE" ] && grep -qxF "$FINGERPRINT" "$VERIFIED_FILE" 2>/dev/null; then
    echo "✅ Тесты для этого состояния кода уже зелёные — пушу без повторного прогона."
    exit 0
fi

remember_green() {
    [ -n "$VERIFIED_FILE" ] || return 0
    echo "$FINGERPRINT" >> "$VERIFIED_FILE" 2>/dev/null || return 0
    # Больше двадцати записей хранить незачем — это кеш, а не журнал.
    if tail -n 20 "$VERIFIED_FILE" > "$VERIFIED_FILE.tmp" 2>/dev/null; then
        mv "$VERIFIED_FILE.tmp" "$VERIFIED_FILE" 2>/dev/null || rm -f "$VERIFIED_FILE.tmp"
    fi
    return 0
}

if ! command -v python3 >/dev/null 2>&1; then
    echo "⚠️  pre-push: python3 не найден — тесты пропущены, пуш продолжается."
    exit 0
fi

if ! python3 -c "import pytest" >/dev/null 2>&1; then
    echo "⚠️  pre-push: pytest не установлен — тесты пропущены, пуш продолжается."
    exit 0
fi

echo "▶️  Прогоняю тесты перед пушем (около минуты)…"
echo "   Совет: ./scripts/push.sh делает то же самое, но пушит ПОСЛЕ прогона —"
echo "   тогда соединение с GitHub не протухает и пуш не срывается по таймауту."
OUTPUT=$(python3 -m pytest backend/tests -q 2>&1)
STATUS=$?

if [ $STATUS -eq 0 ]; then
    echo "$OUTPUT" | tail -n 1
    remember_green
    echo "✅ Тесты зелёные — пушу."
    echo "   Если пуш сорвётся по таймауту — повторите команду: прогон запомнен,"
    echo "   второй раз уйдёт мгновенно."
    exit 0
fi

FAILURES=$(echo "$OUTPUT" | grep -E "^FAILED|^ERROR")

# Прогон мог не состояться вовсе — например, оборвалась сеть или база не ответила.
# Это НЕ красные тесты, и блокировать из-за этого пуш нечестно: человек потратит
# время на поиск несуществующей поломки. Предупреждаем и пропускаем.
if [ -z "$FAILURES" ] && echo "$OUTPUT" | grep -qiE "OperationalError|could not connect|Operation timed out|Connection refused"; then
    echo ""
    echo "⚠️  pre-push: прогон не состоялся — не достучались до внешнего сервиса."
    echo "   Это не поломка кода. Пуш продолжается; прогоните тесты вручную, когда будет связь."
    exit 0
fi

echo ""
echo "$FAILURES" | head -n 20
echo "$OUTPUT" | tail -n 1
echo ""
echo "⛔️ Пуш остановлен: тесты красные."
echo "   Посмотреть подробно:  python3 -m pytest backend/tests -q"
echo "   Запушить всё равно:   git push --no-verify"
exit 1
