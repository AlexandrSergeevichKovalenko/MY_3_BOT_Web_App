FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
  && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir --progress-bar off --retries 10 --timeout 120 -r /app/backend/requirements.txt

COPY backend/ /app/backend/

ENV PYTHONPATH=/app
# Memory: cap glibc malloc arenas + return freed pages to the OS.
ENV MALLOC_ARENA_MAX=2
ENV MALLOC_TRIM_THRESHOLD_=100000
ENV BACKGROUND_JOBS_PROCESSES=1
# Right-sized for 1-2 DAU (was 8). Override via env if load grows.
ENV BACKGROUND_JOBS_THREADS=2
ENV TRANSLATION_CHECK_GLOBAL_ITEM_CONCURRENCY=12
ENV TRANSLATION_CHECK_ITEM_MAX_CONCURRENCY=4

CMD ["sh", "-c", "if [ -n \"$DRAMATIQ_QUEUES\" ]; then queues=$(printf '%s' \"$DRAMATIQ_QUEUES\" | tr ',' ' '); exec python -m dramatiq backend.background_jobs --processes ${BACKGROUND_JOBS_PROCESSES:-1} --threads ${BACKGROUND_JOBS_THREADS:-8} --queues $queues; else exec python -m dramatiq backend.background_jobs --processes ${BACKGROUND_JOBS_PROCESSES:-1} --threads ${BACKGROUND_JOBS_THREADS:-8}; fi"]
